# Copy to .env for local development. Never commit the real .env file.
# Vite only embeds variables prefixed with VITE_ into the built bundle.

# Local backend during development:
VITE_API_URL=http://localhost:8000

# In Netlify's dashboard, set this as a build environment variable pointing
# at your live Render URL instead, e.g.:
# VITE_API_URL=https://csf-food-flow-api.onrender.com
