# Copy to .env for local development. Never commit the real .env file.
# Vite only embeds variables prefixed with VITE_ into the built bundle.

# Local backend during development:
VITE_API_URL=http://localhost:8000

# Production (Netlify): leave VITE_API_URL UNSET. The client then calls
# the relative path /api/v1, which netlify.toml proxies to the API
# server-side. Setting it to the API's own URL would bypass the proxy
# and break the session cookie in Safari and private browsing.